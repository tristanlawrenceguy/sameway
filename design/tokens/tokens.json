{
  "$comment": "Single source of design tokens. Run `go run ./tools/tokens` to regenerate tokens.css. Text roles meet WCAG 2.2 AAA (7:1) on bg, bg-muted, and bg-raised in both themes; the Go test internal/tokens/contrast_test.go enforces it. Roles: human (indigo) marks people's actions, assistant (teal) marks the model's, system (amber) marks the software's own notices.",
  "color": {
    "bg": { "light": "#fdfcfa", "dark": "#0f1117" },
    "bg-muted": { "light": "#f3f1ec", "dark": "#1e222c" },
    "bg-raised": { "light": "#ffffff", "dark": "#171a22" },
    "fg": { "light": "#15161c", "dark": "#f2f3f7" },
    "fg-muted": { "light": "#474b59", "dark": "#b4b9c6" },
    "border": { "light": "#c9c6bd", "dark": "#343a48" },
    "border-strong": { "light": "#7a7f8c", "dark": "#7f8798" },

    "accent": { "light": "#3a2ccc", "dark": "#b8bfff" },
    "accent-fg": { "light": "#ffffff", "dark": "#0f1117" },
    "accent-soft": { "light": "#e9e7ff", "dark": "#252a52" },

    "human": { "light": "#3a2ccc", "dark": "#b8bfff" },
    "human-soft": { "light": "#e9e7ff", "dark": "#252a52" },
    "assistant": { "light": "#075a44", "dark": "#6ee7bf" },
    "assistant-soft": { "light": "#dff5ec", "dark": "#123c31" },
    "system": { "light": "#703e00", "dark": "#f5c26b" },
    "system-soft": { "light": "#fbe9cf", "dark": "#3d2b0d" },

    "success": { "light": "#0f5a31", "dark": "#7ee2a5" },
    "success-soft": { "light": "#dcf3e4", "dark": "#153a26" },
    "warning": { "light": "#703e00", "dark": "#f5c26b" },
    "warning-soft": { "light": "#fbe9cf", "dark": "#3d2b0d" },
    "danger": { "light": "#961c30", "dark": "#ff9aa8" },
    "danger-soft": { "light": "#fee8eb", "dark": "#4a1c25" },
    "info": { "light": "#2440ba", "dark": "#9db4ff" },
    "info-soft": { "light": "#e8edff", "dark": "#1a2547" },

    "focus": { "light": "#d9531e", "dark": "#ffb076" },
    "focus-halo": { "light": "#ffffff", "dark": "#0f1117" }
  },
  "font": {
    "sans": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace"
  },
  "size": {
    "text-xs": "0.8125rem",
    "text-sm": "0.9375rem",
    "text-md": "1.0625rem",
    "text-lg": "clamp(1.2rem, 1.1rem + 0.5vw, 1.35rem)",
    "text-xl": "clamp(1.5rem, 1.3rem + 1vw, 1.9rem)",
    "text-2xl": "clamp(2rem, 1.6rem + 2vw, 2.75rem)",
    "line": "1.6",
    "line-tight": "1.2",
    "target": "2.75rem",
    "measure": "68ch"
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "12": "3rem",
    "16": "4rem"
  },
  "radius": { "sm": "0.375rem", "md": "0.625rem", "lg": "1rem", "pill": "999px" },
  "shadow": {
    "1": { "light": "0 1px 2px rgb(21 22 28 / 0.06), 0 1px 3px rgb(21 22 28 / 0.08)", "dark": "0 1px 2px rgb(0 0 0 / 0.5), 0 0 0 1px rgb(255 255 255 / 0.04)" },
    "2": { "light": "0 6px 16px rgb(21 22 28 / 0.08), 0 2px 4px rgb(21 22 28 / 0.06)", "dark": "0 8px 24px rgb(0 0 0 / 0.6), 0 0 0 1px rgb(255 255 255 / 0.06)" }
  },
  "motion": {
    "fast": "120ms",
    "base": "220ms",
    "slow": "420ms",
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "ease-out": "cubic-bezier(0, 0, 0.2, 1)"
  },
  "focus": { "width": "3px", "offset": "2px" }
}
