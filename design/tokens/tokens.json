{
  "$comment": "Single source of design tokens. Run `go run ./tools/tokens` to regenerate tokens.css. Colors are chosen for WCAG 2.2 AAA (7:1 text contrast) on their intended surfaces.",
  "color": {
    "bg": { "light": "#ffffff", "dark": "#121417" },
    "bg-muted": { "light": "#f3f4f6", "dark": "#1c1f24" },
    "fg": { "light": "#1a1c20", "dark": "#f2f3f5" },
    "fg-muted": { "light": "#4b5057", "dark": "#b8bec7" },
    "border": { "light": "#6b7078", "dark": "#8a919b" },
    "accent": { "light": "#1d4ed8", "dark": "#93b4ff" },
    "accent-fg": { "light": "#ffffff", "dark": "#0b1a3a" },
    "focus": { "light": "#c2410c", "dark": "#ffb27a" },
    "success": { "light": "#166534", "dark": "#86efac" },
    "warning": { "light": "#854d0e", "dark": "#fde68a" },
    "danger": { "light": "#991b1b", "dark": "#fca5a5" },
    "info": { "light": "#1e40af", "dark": "#bfdbfe" }
  },
  "font": {
    "sans": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace"
  },
  "size": {
    "text-sm": "0.9375rem",
    "text-md": "1.0625rem",
    "text-lg": "1.25rem",
    "text-xl": "1.5rem",
    "text-2xl": "1.875rem",
    "line": "1.6",
    "target": "2.75rem",
    "measure": "68ch"
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "12": "3rem"
  },
  "radius": { "sm": "0.25rem", "md": "0.5rem" },
  "focus": { "width": "3px", "offset": "2px" }
}
